{
  "bash": {
    "description": "Execute a shell command",
    "nativeName": "shell",
    "commonName": "bash",
    "toolUseKind": "bash",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  "webSearch": {
    "description": "Search the web",
    "nativeName": "web_search",
    "commonName": "webSearch",
    "toolUseKind": "readonly",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  "apply_patch": {
    "description": "Apply a patch to files",
    "toolUseKind": "edit",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "string"
    }
  },
  "view_image": {
    "description": "View a local image file",
    "toolUseKind": "readonly",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "enum": [
            "high",
            "original"
          ]
        },
        "environment_id": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  }
}
