      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "offset": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "pages": {
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    }
  },
  "write": {
    "description": "Overwrite or create a file at an absolute path",
    "nativeName": "Write",
    "commonName": "write",
    "toolUseKind": "edit",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
