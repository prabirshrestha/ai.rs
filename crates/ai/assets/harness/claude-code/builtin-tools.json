          "type": "string"
        },
        "timeout_ms": {
          "type": "number"
        },
        "persistent": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "ws": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "protocols": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "ListAgents": {
