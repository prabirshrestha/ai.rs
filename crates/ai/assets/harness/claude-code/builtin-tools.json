        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    }
  },
  "grep": {
    "description": "Regex search over file contents via ripgrep",
    "nativeName": "Grep",
    "commonName": "grep",
    "toolUseKind": "readonly",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
