          "type": "number"
        },
        "-A": {
          "type": "number"
        },
        "-C": {
          "type": "number"
        },
        "context": {
          "type": "number"
        },
        "-n": {
          "type": "boolean"
        },
        "-i": {
          "type": "boolean"
        },
        "-o": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "head_limit": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "multiline": {
          "type": "boolean"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    }
  },
