        "content": {
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "content"
      ],
      "additionalProperties": false
    }
  },
  "edit": {
    "description": "Edit a file by exact string replacement",
    "nativeName": "Edit",
    "commonName": "edit",
    "toolUseKind": "edit",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
